{
  "name": "apexviz",
  "displayName": "ApexViz",
  "description": "Apex Flowchart Generator is an offline VS Code extension visual Aid tool that converts Apex code into structured, flowchart-style diagrams similar to Salesforce Flows.",
  "version": "0.0.1",
  "publisher": "PanangipalliSaiCharan",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "icon": "Images/apexVizImage.jpg",
  "license": "MIT",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apexViz.visualizeApexClass",
        "title": "ApexViz: Visualize Apex Class"
      }
      
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "^5.0.0-beta.5",
    "antlr4": "^4.13.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monkeyluffy824/apexViz"
  },
"homepage": "https://github.com/monkeyluffy824/apexViz",
"bugs": {
  "url": "https://github.com/monkeyluffy824/apexViz/issues"
},
"keywords": ["apex","salesforce","flowchart","mermaid","visualization"]
}
